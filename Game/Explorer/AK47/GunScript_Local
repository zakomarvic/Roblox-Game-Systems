local Tool = script.Parent
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Workspace = workspace

local Module = require(Tool:WaitForChild("Setting"))
local WeaponController = require(ReplicatedStorage.WeaponSystem.Modules.WeaponController)
local BulletVisualizer = require(ReplicatedStorage.WeaponSystem.Modules.BulletVisualizer)
local WeaponCamera = require(ReplicatedStorage.WeaponSystem.Modules.WeaponCamera)
local CharacterController = require(ReplicatedStorage.CharacterSystem.Modules.CharacterController)
local WeaponPose = require(ReplicatedStorage.WeaponSystem.Modules.WeaponPose)

local WeaponEffects = ReplicatedStorage:WaitForChild("WeaponSystem"):WaitForChild("Remotes"):WaitForChild("WeaponEffects")
local InflictTarget = ReplicatedStorage:WaitForChild("WeaponSystem"):WaitForChild("Remotes"):WaitForChild("InflictTarget")

local Controller = WeaponController.new(Tool, Module)
local CurrentPose
local AimConnection

local Handle = Tool:WaitForChild("Handle")
local Player = Players.LocalPlayer
local Mouse = Player:GetMouse()
local Camera = Workspace.CurrentCamera
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local CharacterControllerInstance = CharacterController.Get()
local WeaponCameraInstance = WeaponCamera.new(Camera, Humanoid, Character, Module)

local GUI = script:WaitForChild("GunGUI")
local IdleAnim
local FireAnim
local ReloadAnim
local ShotgunClipinAnim
local Grip2
local Handle2
local HandleToFire = Handle

if Module.DualEnabled then
	Handle2 = Tool:WaitForChild("Handle2", 2)
	if Handle2 == nil then
		error('"Dual" setting is enabled but "Handle2" is missing!')
	end
end

local Equipped = false
local AimDown = false
local PiercedHumanoid = {}

if Module.IdleAnimationID ~= nil or Module.DualEnabled then
	IdleAnim = Tool:WaitForChild("IdleAnim")
	IdleAnim = Humanoid:LoadAnimation(IdleAnim)
end
if Module.FireAnimationID ~= nil then
	FireAnim = Tool:WaitForChild("FireAnim")
	FireAnim = Humanoid:LoadAnimation(FireAnim)
end
if Module.ReloadAnimationID ~= nil then
	ReloadAnim = Tool:WaitForChild("ReloadAnim")
	ReloadAnim = Humanoid:LoadAnimation(ReloadAnim)
end
if Module.ShotgunClipinAnimationID ~= nil then
	ShotgunClipinAnim = Tool:WaitForChild("ShotgunClipinAnim")
	ShotgunClipinAnim = Humanoid:LoadAnimation(ShotgunClipinAnim)
end

local function wait(TimeToWait)
	if TimeToWait ~= nil then
		local TotalTime = 0
		TotalTime += RunService.Heartbeat:Wait()
		while TotalTime < TimeToWait do
			TotalTime += RunService.Heartbeat:Wait()
		end
	else
		RunService.Heartbeat:Wait()
	end
end

local function RayCast(Start, Direction, Range, Ignore)
	local Hit, EndPos = Workspace:FindPartOnRay(Ray.new(Start, Direction * Range), Ignore)
	if Hit then
		if (
			Hit.Transparency > 0.75
			or Hit.Name == "Handle"
			or Hit.Name == "Effect"
			or Hit.Name == "Bullet"
			or Hit.Name == "Laser"
			or string.lower(Hit.Name) == "water"
			or Hit.Name == "Rail"
			or Hit.Name == "Arrow"
			or (Hit.Parent:FindFirstChild("Humanoid") and Hit.Parent.Humanoid.Health == 0)
			or (Hit.Parent:FindFirstChild("Humanoid") and Hit.Parent:FindFirstChild("TEAM") and Hit.Parent.TEAM.Value == Hit.Parent.TEAM.Value)
			or (Hit.Parent:FindFirstChild("Humanoid") and PiercedHumanoid[Hit.Parent.Humanoid])
		) then
			Hit, EndPos = RayCast(EndPos + Direction * 0.01, Direction, Range - (Start - EndPos).Magnitude, Ignore)
		end
	end
	return Hit, EndPos
end

local function ShakeCamera()
	WeaponCameraInstance:AddRecoil()
end

RunService.RenderStepped:Connect(function(DeltaTime)
	WeaponCameraInstance:SetEquipped(Equipped)
	WeaponCameraInstance:SetAiming(AimDown)
	WeaponCameraInstance:Update(DeltaTime)
end)

local function Fire(ShootingHandle)
	local PierceAvailable = Module.Piercing
	PiercedHumanoid = {}

	if FireAnim then
		FireAnim:Play(nil, nil, Module.FireAnimationSpeed)
	end

	if not ShootingHandle.FireSound.Playing or not ShootingHandle.FireSound.Looped then
		ShootingHandle.FireSound:Play()
		WeaponEffects:FireServer(Tool, "Fire")
	end

	local Start = (Humanoid.Torso.CFrame * CFrame.new(0, 1.5, 0)).Position
	local Spread = Module.Spread * (AimDown and 1 - Module.SpreadRedution or 1)
	local Direction = (CFrame.new(Start, Mouse.Hit.Position) * CFrame.Angles(
		math.rad(-Spread + math.random() * (Spread * 2)),
		math.rad(-Spread + math.random() * (Spread * 2)),
		0
	)).LookVector

	while PierceAvailable >= 0 do
		local Hit, EndPos = RayCast(Start, Direction, 5000, Character)

		if not Module.ExplosiveEnabled then
			if Hit and Hit.Parent then
				local TargetHumanoid = Hit.Parent:FindFirstChild("Humanoid")
				local TargetTorso = Hit.Parent:FindFirstChild("Torso")
				if TargetHumanoid and TargetHumanoid.Health > 0 and TargetTorso then
					InflictTarget:FireServer(TargetHumanoid, TargetTorso, Hit, Direction)
					PiercedHumanoid[TargetHumanoid] = true
				else
					PierceAvailable = 0
				end
			end
		else
			local Explosion = Instance.new("Explosion")
			Explosion.BlastRadius = Module.Radius
			Explosion.BlastPressure = 0
			Explosion.Position = EndPos
			Explosion.Parent = Workspace.CurrentCamera
			Explosion.Hit:Connect(function(HitPart)
				if HitPart and HitPart.Parent and HitPart.Name == "Torso" then
					local TargetHumanoid = HitPart.Parent:FindFirstChild("Humanoid")
					local TargetTorso = HitPart.Parent:FindFirstChild("Torso")
					if TargetHumanoid and TargetHumanoid.Health > 0 and TargetTorso then
						InflictTarget:FireServer(TargetHumanoid, TargetTorso, HitPart, Direction)
					end
				end
			end)
			PierceAvailable = 0
		end

		PierceAvailable = Hit and (PierceAvailable - 1) or -1

		task.spawn(function()
			BulletVisualizer.Visualize(
				ShootingHandle,
				Module.MuzzleOffset,
				EndPos,
				script.MuzzleEffect,
				script.HitEffect,
				Module.HitSoundIDs[math.random(1, #Module.HitSoundIDs)],
				{Module.ExplosiveEnabled, Module.BlastRadius, Module.BlastPressure},
				{Module.BulletSpeed, Module.BulletSize, Module.BulletColor, Module.BulletTransparency, Module.BulletMaterial, Module.FadeTime},
				false,
				PierceAvailable == -1 and Module.VisualizerEnabled or false
			)
		end)

		WeaponEffects:FireServer(
			Tool,
			"Bullet",
			ShootingHandle,
			Module.MuzzleOffset,
			EndPos,
			script.MuzzleEffect,
			script.HitEffect,
			Module.HitSoundIDs[math.random(1, #Module.HitSoundIDs)],
			{Module.ExplosiveEnabled, Module.BlastRadius, Module.BlastPressure},
			{Module.BulletSpeed, Module.BulletSize, Module.BulletColor, Module.BulletTransparency, Module.BulletMaterial, Module.FadeTime},
			true,
			PierceAvailable == -1 and Module.VisualizerEnabled or false
		)

		Start = EndPos + Direction * 0.01
	end
end

local function UpdateGUI()
	local CurrentAmmo = Controller:GetAmmo()
	local CurrentClips = Controller:GetClips()

	GUI.Frame.Ammo.Fill:TweenSizeAndPosition(UDim2.new(CurrentAmmo / Module.AmmoPerClip, 0, 1, 0), UDim2.new(0, 0, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quint, 0.25, true)
	GUI.Frame.Clips.Fill:TweenSizeAndPosition(UDim2.new(CurrentClips / Module.MaxClip, 0, 1, 0), UDim2.new(0, 0, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quint, 0.25, true)

	GUI.Frame.Ammo.Current.Text = CurrentAmmo
	GUI.Frame.Ammo.Max.Text = Module.AmmoPerClip
	GUI.Frame.Clips.Current.Text = CurrentClips
	GUI.Frame.Clips.Max.Text = Module.MaxClip

	GUI.Frame.Ammo.Current.Visible = not Controller:GetReloading()
	GUI.Frame.Ammo.Max.Visible = not Controller:GetReloading()
	GUI.Frame.Ammo.Frame.Visible = not Controller:GetReloading()
	GUI.Frame.Ammo.Reloading.Visible = Controller:GetReloading()
	GUI.Frame.Clips.Current.Visible = CurrentClips > 0
	GUI.Frame.Clips.Max.Visible = CurrentClips > 0
	GUI.Frame.Clips.Frame.Visible = CurrentClips > 0
	GUI.Frame.Clips.NoMoreClip.Visible = CurrentClips <= 0
	GUI.Frame.Clips.Visible = Module.LimitedClipEnabled
	GUI.Frame.Size = Module.LimitedClipEnabled and UDim2.new(0, 250, 0, 100) or UDim2.new(0, 250, 0, 55)
	GUI.Frame.Position = Module.LimitedClipEnabled and UDim2.new(1, -260, 1, -110) or UDim2.new(1, -260, 1, -65)
end

local function SetAim(State)
	AimDown = State
	WeaponCameraInstance:SetAiming(State)
end

local function ResetAim()
	Camera.FieldOfView = 70
	GUI.Scope.Visible = false
	Player.CameraMode = Enum.CameraMode.Classic
	script["Mouse Sensitivity"].Disabled = true
	SetAim(false)
	Mouse.Icon = "rbxassetid://" .. Module.MouseIconID
end

local function Reload()
	if Module.SprintEnabled and CharacterControllerInstance:IsSprinting() then
		return
	end
	if not Controller:CanReload() then
		return
	end
	if not Controller:StartReload() then
		return
	end
	if AimDown then
		ResetAim()
	end
	UpdateGUI()

	if Module.ShotgunReload then
		for _ = 1, (Module.AmmoPerClip - Controller:GetAmmo()) do
			if ShotgunClipinAnim then
				ShotgunClipinAnim:Play(nil, nil, Module.ShotgunClipinAnimationSpeed)
			end
			Handle.ShotgunClipin:Play()
			wait(Module.ShellClipinSpeed)
		end
	end

	if ReloadAnim then
		ReloadAnim:Play(nil, nil, Module.ReloadAnimationSpeed)
	end
	Handle.ReloadSound:Play()
	WeaponEffects:FireServer(Tool, "Reload")
	wait(Module.ReloadTime)
	Controller:FinishReload()
	UpdateGUI()
end

Mouse.Button1Down:Connect(function()
	if Module.SprintEnabled and CharacterControllerInstance:IsSprinting() then
		return
	end

	Controller:SetTriggerHeld(true)
	local IsChargedShot = false

	if not Equipped or not Controller:CanFireNow() or Humanoid.Health <= 0 then
		return
	end
	if not Controller:StartFiring() then
		return
	end

	Controller:SetEnabled(false)

	if Module.ChargedShotEnabled then
		if HandleToFire:FindFirstChild("ChargeSound") then
			HandleToFire.ChargeSound:Play()
		end
		wait(Module.ChargingTime)
		IsChargedShot = true
	end

	if Module.MinigunEnabled then
		if HandleToFire:FindFirstChild("WindUp") then
			HandleToFire.WindUp:Play()
		end
		wait(Module.DelayBeforeFiring)
	end

	Controller:RunFireCycle(
		function()
			return Equipped
				and not Controller:GetReloading()
				and not (Module.SprintEnabled and CharacterControllerInstance:IsSprinting())
				and (Controller:IsTriggerHeld() or IsChargedShot)
				and Controller:GetAmmo() > 0
				and Humanoid.Health > 0
		end,
		function()
			IsChargedShot = false
			task.spawn(ShakeCamera)

			for _ = 1, (Module.ShotgunEnabled and Module.BulletPerShot or 1) do
				Fire(HandleToFire)
			end

			Controller:ConsumeAmmo(1)
			UpdateGUI()

			HandleToFire = (HandleToFire == Handle and Module.DualEnabled) and Handle2 or Handle
		end
	)

	if HandleToFire.FireSound.Playing and HandleToFire.FireSound.Looped then
		HandleToFire.FireSound:Stop()
	end

	if Module.MinigunEnabled then
		if HandleToFire:FindFirstChild("WindDown") then
			HandleToFire.WindDown:Play()
		end
		wait(Module.DelayAfterFiring)
	end

	Controller:StopFiring()
	Controller:SetEnabled(true)

	if Controller:GetAmmo() <= 0 then
		Reload()
	end
end)

Mouse.Button1Up:Connect(function()
	Controller:SetTriggerHeld(false)
end)

Tool.Equipped:Connect(function(TempMouse)
	Equipped = true
	WeaponCameraInstance:SetEquipped(true)
	UpdateGUI()

	if Module.BodyAimEnabled then
		CurrentPose = WeaponPose.Equip(Character, Module)
		if CurrentPose then
			AimConnection = RunService.RenderStepped:Connect(function()
				if not Equipped or not CurrentPose then
					return
				end
				WeaponPose.UpdateAim(CurrentPose, Mouse.Hit.Position)
			end)
		end
	end

	if Module.AmmoPerClip ~= math.huge then
		GUI.Parent = Player.PlayerGui
	end
	TempMouse.Icon = "rbxassetid://" .. Module.MouseIconID
	if IdleAnim then
		IdleAnim:Play(nil, nil, Module.IdleAnimationSpeed)
	end

	TempMouse.KeyDown:Connect(function(Key)
		if string.lower(Key) == "r" then
			Reload()
		elseif string.lower(Key) == "e" then
			if not Controller:GetReloading() and not AimDown and Module.SniperEnabled then
				Camera.FieldOfView = Module.FieldOfView
				GUI.Scope.Visible = true
				Player.CameraMode = Enum.CameraMode.LockFirstPerson
				script["Mouse Sensitivity"].Disabled = false
				SetAim(true)
				Mouse.Icon = "http://www.roblox.com/asset?id=187746799"
			else
				ResetAim()
			end
		end
	end)

	if Module.DualEnabled and not Workspace.FilteringEnabled then
		Handle2.CanCollide = false
		local LeftArm = Tool.Parent:FindFirstChild("Left Arm")
		local RightArm = Tool.Parent:FindFirstChild("Right Arm")
		if RightArm then
			local Grip = RightArm:WaitForChild("RightGrip", 0.01)
			if Grip then
				Grip2 = Grip:Clone()
				Grip2.Name = "LeftGrip"
				Grip2.Part0 = LeftArm
				Grip2.Part1 = Handle2
				Grip2.Parent = LeftArm
			end
		end
	end
end)

Tool.Unequipped:Connect(function()
	Equipped = false
	WeaponCameraInstance:SetEquipped(false)
	SetAim(false)
	GUI.Parent = script

	if AimConnection then
		AimConnection:Disconnect()
		AimConnection = nil
	end
	if CurrentPose then
		WeaponPose.Unequip(CurrentPose)
		CurrentPose = nil
	end
	if IdleAnim then
		IdleAnim:Stop()
	end
	if Module.DualEnabled and not Workspace.FilteringEnabled then
		Handle2.CanCollide = true
		if Grip2 then
			Grip2:Destroy()
			Grip2 = nil
		end
	end
end)

Humanoid.Died:Connect(function()
	Equipped = false
	WeaponCameraInstance:SetEquipped(false)
	SetAim(false)
	GUI.Parent = script
	if IdleAnim then
		IdleAnim:Stop()
	end
	if AimConnection then
		AimConnection:Disconnect()
		AimConnection = nil
	end
	if CurrentPose then
		WeaponPose.Unequip(CurrentPose)
		CurrentPose = nil
	end
	if Module.DualEnabled and not Workspace.FilteringEnabled then
		Handle2.CanCollide = true
		if Grip2 then
			Grip2:Destroy()
			Grip2 = nil
		end
	end
end)

CharacterControllerInstance.SprintChanged.Event:Connect(function(IsSprinting)
	if IsSprinting then
		Controller:SetTriggerHeld(false)
		if Controller:GetReloading() then
			Controller:SetReloading(false)
		end
		if Controller:IsCurrentlyFiring() then
			Controller:StopFiring()
		end
	end
end)