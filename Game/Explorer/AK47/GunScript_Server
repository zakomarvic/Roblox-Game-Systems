local Tool = script.Parent

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WeaponPose = require(
	ReplicatedStorage.WeaponSystem.Modules.WeaponPose
)

local WeaponAnimations = require(
	ReplicatedStorage.WeaponSystem.Modules.WeaponAnimations
)

local WeaponGrip = require(
	ReplicatedStorage.WeaponSystem.Modules.WeaponGrip
)

local Module = require(Tool:WaitForChild("Setting"))

local CurrentPose
local GripData

WeaponAnimations.Create(Tool, Module)

Tool.Equipped:Connect(function()
	local Character = Tool.Parent

	CurrentPose = WeaponPose.Equip(Character, Module)

	if Module.DualEnabled and workspace.FilteringEnabled then
		GripData = WeaponGrip.Equip(Tool, Module)
	end
end)

Tool.Unequipped:Connect(function()
	WeaponPose.Unequip(CurrentPose)
	CurrentPose = nil

	if GripData then
		WeaponGrip.Unequip(GripData)
		GripData = nil
	end
end)
