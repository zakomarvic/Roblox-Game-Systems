local Tool = script.Parent

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WeaponPose = require(
	ReplicatedStorage.WeaponSystem.Modules.WeaponPose
)

local WeaponAnimations = require(
	ReplicatedStorage.WeaponSystem.Modules.WeaponAnimations
)

local Module = require(Tool:WaitForChild("Setting"))

local Grip2
local Handle2
local CurrentPose

WeaponAnimations.Create(Tool, Module)

if Module.DualEnabled then
	Handle2 = Tool:WaitForChild("Handle2", 1)
	if Handle2 == nil then
		error('"Dual" setting is enabled but "Handle2" is missing!')
	end
end

Tool.Equipped:Connect(function()
	local Character = Tool.Parent

	CurrentPose = WeaponPose.Equip(Character, Module)

	if Module.DualEnabled and workspace.FilteringEnabled then
		Handle2.CanCollide = false

		local LeftArm = Character:FindFirstChild("Left Arm")
		local RightArm = Character:FindFirstChild("Right Arm")

		if RightArm then
			local Grip = RightArm:WaitForChild("RightGrip", 0.01)

			if Grip then
				Grip2 = Grip:Clone()
				Grip2.Name = "LeftGrip"
				Grip2.Part0 = LeftArm
				Grip2.Part1 = Handle2
				Grip2.Parent = LeftArm
			end
		end
	end
end)

Tool.Unequipped:Connect(function()
	WeaponPose.Unequip(CurrentPose)
	CurrentPose = nil

	if Module.DualEnabled and workspace.FilteringEnabled then
		Handle2.CanCollide = true

		if Grip2 then
			Grip2:Destroy()
			Grip2 = nil
		end
	end
end)
