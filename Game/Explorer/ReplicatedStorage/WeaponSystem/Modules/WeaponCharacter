local WeaponCharacter = {}
WeaponCharacter.__index = WeaponCharacter

function WeaponCharacter.new(Config)
	local self = setmetatable({}, WeaponCharacter)
	self.Character = Config.Character
	self.Humanoid = Config.Humanoid
	self.Camera = Config.Camera
	self.Fire = Config.Fire
	self.FireCycle = Config.FireCycle
	self.Animation = Config.Animation
	self.Tool = Config.Tool
	self.Module = Config.Module
	self.Handle2 = Config.Handle2
	self.Mouse = Config.Mouse
	self.Workspace = Config.Workspace or workspace
	self.CurrentPose = nil
	self.Grip2 = nil
	self.PoseRequested = false
	return self
end

function WeaponCharacter:SetCharacter(Character, Humanoid)
	local PoseRequested = self.PoseRequested
	self:ClearPose()
	self.Character = Character
	self.Humanoid = Humanoid
	self.PoseRequested = PoseRequested

	if self.Camera then
		self.Camera:SetCharacter(Character, Humanoid)
	end
	if self.Fire then
		self.Fire:SetCharacter(Character, Humanoid)
	end
	if self.FireCycle then
		self.FireCycle:SetHumanoid(Humanoid)
	end
	if self.Animation then
		self.Animation:SetHumanoid(Humanoid)
	end

	-- CharacterAdded can race with Tool.Equipped after a respawn. If the
	-- pose was already requested, re-apply it to the new character after
	-- the character references have been updated.
	if PoseRequested then
		task.defer(function()
			if self.PoseRequested and self.Character == Character and self.Humanoid == Humanoid then
				self:EquipPose()
			end
		end)
	end
end

function WeaponCharacter:EquipPose()
	if not self.Module.BodyAimEnabled then return end
	local WeaponPose = require(game.ReplicatedStorage.WeaponSystem.Modules.WeaponPose)
	self.PoseRequested = true
	self:ClearPose()
	self.PoseRequested = true

	local Character = self.Character
	if not Character or not Character.Parent then return end
	local Humanoid = self.Humanoid or Character:FindFirstChildOfClass("Humanoid")
	if not Humanoid or Humanoid.Health <= 0 then return end

	-- After respawn, Tool.Equipped can fire before the R6 shoulder joints
	-- have finished appearing. Wait for the exact parts the pose needs.
	local Torso = Character:WaitForChild("Torso", 2)
	if not Torso then return end
	local LeftShoulder = Torso:WaitForChild("Left Shoulder", 2)
	local RightShoulder = Torso:WaitForChild("Right Shoulder", 2)
	if not LeftShoulder or not RightShoulder then return end

	self.CurrentPose = WeaponPose.Equip(Character, self.Module)
	if self.CurrentPose then
		WeaponPose.BindAim(self.CurrentPose, self.Mouse)
	end
	if self.Module.DualEnabled then
		self.Grip2 = WeaponPose.CreateDualGrip(self.Tool, Character, self.Handle2, self.Workspace.FilteringEnabled)
	end
end

function WeaponCharacter:ClearPose()
	local WeaponPose = require(game.ReplicatedStorage.WeaponSystem.Modules.WeaponPose)
	self.PoseRequested = false
	if self.CurrentPose then
		WeaponPose.Unequip(self.CurrentPose)
		self.CurrentPose = nil
	end
	WeaponPose.DestroyDualGrip(self.Grip2, self.Handle2, self.Workspace.FilteringEnabled)
	self.Grip2 = nil
end

function WeaponCharacter:GetCharacter()
	return self.Character
end

function WeaponCharacter:GetHumanoid()
	return self.Humanoid
end

return WeaponCharacter
