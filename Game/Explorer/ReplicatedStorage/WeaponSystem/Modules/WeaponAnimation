local WeaponAnimation = {}
WeaponAnimation.__index = WeaponAnimation

function WeaponAnimation.new(Config)
	local self = setmetatable({}, WeaponAnimation)
	self.Tool = Config.Tool
	self.Humanoid = Config.Humanoid
	self.Module = Config.Module
	self.Tracks = {}
	self:_load()
	return self
end

function WeaponAnimation:_load()
	local Module = self.Module
	local Humanoid = self.Humanoid
	if not Humanoid then return end

	local function load(Name, Enabled)
		if not Enabled then return nil end
		local Animation = self.Tool:WaitForChild(Name)
		local Track = Humanoid:LoadAnimation(Animation)
		self.Tracks[Name] = Track
		print(string.format("[WeaponAnimation] Loaded %s on Humanoid=%s Priority=%s", Name, Humanoid:GetDebugId(), tostring(Track.Priority)))
		Track.Stopped:Connect(function()
			print(string.format("[WeaponAnimation] Stopped %s on Humanoid=%s", Name, Humanoid:GetDebugId()))
		end)
		return Track
	end

	load("IdleAnim", Module.IdleAnimationID ~= nil or Module.DualEnabled)
	load("FireAnim", Module.FireAnimationID ~= nil)
	load("ReloadAnim", Module.ReloadAnimationID ~= nil)
	load("ShotgunClipinAnim", Module.ShotgunClipinAnimationID ~= nil)
end

function WeaponAnimation:SetHumanoid(Humanoid)
	print(string.format("[WeaponAnimation] SetHumanoid old=%s new=%s", self.Humanoid and self.Humanoid:GetDebugId() or "nil", Humanoid and Humanoid:GetDebugId() or "nil"))
	self:StopAll()
	self.Humanoid = Humanoid
	self.Tracks = {}
	self:_load()
end

function WeaponAnimation:Get(Name)
	return self.Tracks[Name]
end

function WeaponAnimation:GetAll()
	return self.Tracks
end

function WeaponAnimation:StopAll()
	for Name, Track in pairs(self.Tracks) do
		if Track then
			print(string.format("[WeaponAnimation] StopAll %s", Name))
			Track:Stop()
		end
	end
end

return WeaponAnimation
