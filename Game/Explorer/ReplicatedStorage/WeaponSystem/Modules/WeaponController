local WeaponController = {}
WeaponController.__index = WeaponController

function WeaponController.new(Tool, Settings)
	local self = setmetatable({}, WeaponController)

	self.Tool = Tool
	self.Settings = Settings
	self.Ammo = Settings.AmmoPerClip
	self.Clips = Settings.LimitedClipEnabled and Settings.Clips or 0
	self.IsFiring = false
	self.IsReloading = false
	self.LastFireTime = 0
	self.Enabled = true
	self.TriggerHeld = false

	return self
end

function WeaponController:GetSetting(Name)
	return self.Settings[Name]
end

function WeaponController:GetAmmo()
	return self.Ammo
end

function WeaponController:GetClips()
	return self.Clips
end

function WeaponController:SetAmmo(Amount)
	self.Ammo = Amount
end

function WeaponController:SetClips(Amount)
	self.Clips = Amount
end

function WeaponController:ConsumeAmmo(Amount)
	Amount = Amount or 1

	if self.Ammo == math.huge then
		return true
	end

	if self.Ammo < Amount then
		return false
	end

	self.Ammo -= Amount
	return true
end

function WeaponController:CanFire()
	if not self.Enabled or self.IsFiring or self.IsReloading then
		return false
	end

	return self.Ammo > 0 or self.Ammo == math.huge
end

function WeaponController:CanFireNow()
	if not self:CanFire() then
		return false
	end

	local FireRate = self.Settings.FireRate or 0
	return os.clock() - self.LastFireTime >= FireRate
end

function WeaponController:SetFiring(Value)
	self.IsFiring = Value
end

function WeaponController:IsCurrentlyFiring()
	return self.IsFiring
end

function WeaponController:SetReloading(Value)
	self.IsReloading = Value
end

function WeaponController:IsCurrentlyReloading()
	return self.IsReloading
end

function WeaponController:CanReload()
	if not self.Enabled or self.IsFiring or self.IsReloading then
		return false
	end

	if self.Ammo >= self.Settings.AmmoPerClip then
		return false
	end

	if self.Settings.LimitedClipEnabled and self.Clips <= 0 then
		return false
	end

	return true
end

function WeaponController:StartReload()
	if not self:CanReload() then
		return false
	end

	self.IsReloading = true
	return true
end

function WeaponController:FinishReload()
	if not self.IsReloading then
		return
	end

	local Needed = self.Settings.AmmoPerClip - self.Ammo

	if self.Settings.LimitedClipEnabled then
		Needed = math.min(Needed, self.Clips)
		self.Clips -= Needed
	end

	self.Ammo += Needed
	self.IsReloading = false
end

function WeaponController:SetEnabled(Value)
	self.Enabled = Value
end

function WeaponController:IsEnabled()
	return self.Enabled
end

function WeaponController:SetTriggerHeld(Value)
	self.TriggerHeld = Value
end

function WeaponController:IsTriggerHeld()
	return self.TriggerHeld
end

function WeaponController:GetReloading()
	return self.IsReloading
end

function WeaponController:StartFiring()
	if not self:CanFire() then
		return false
	end

	self.IsFiring = true
	self.LastFireTime = os.clock()
	return true
end

function WeaponController:StopFiring()
	self.IsFiring = false
end

-- Runs the generic fire cycle. The weapon script supplies the actual shot.
-- The controller owns burst/automatic timing and ammo consumption.
function WeaponController:RunFireCycle(ShouldContinue, FireShot, OnCycleFinished)
	if not self:IsCurrentlyFiring() then
		return false
	end

	local Settings = self.Settings
	local ChargedShot = false

	while ShouldContinue() and self:GetAmmo() > 0 do
		local BurstCount = Settings.BurstFireEnabled and Settings.BulletPerBurst or 1

		for _ = 1, BurstCount do
			if not ShouldContinue() or self:GetAmmo() <= 0 then
				break
			end

			if not FireShot() then
				self:StopFiring()
				if OnCycleFinished then
					OnCycleFinished()
				end
				return false
			end

			self:ConsumeAmmo(1)

			if Settings.BurstFireEnabled then
				task.wait(Settings.BurstRate or 0)
			end
		end

		if not Settings.Auto then
			break
		end

		task.wait(Settings.FireRate or 0)
	end

	self:StopFiring()

	if OnCycleFinished then
		OnCycleFinished()
	end

	return true
end

return WeaponController
