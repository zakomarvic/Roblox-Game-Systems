local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ProjectileController = {}
ProjectileController.__index = ProjectileController

local DEFAULTS = { Speed = 300, Gravity = Vector3.new(0, -workspace.Gravity, 0), MaxLifetime = 10, RaycastParams = nil, IgnoreWater = true, ProjectileFolderName = "Projectiles" }

local function copyDefaults(Settings)
	local Result = {}
	for Name, Value in pairs(DEFAULTS) do Result[Name] = Value end
	for Name, Value in pairs(Settings or {}) do Result[Name] = Value end
	return Result
end

local function setVisualCFrame(Visual, Position, Direction, Rotation)
	if not Visual or not Visual.Parent then return end
	local Look = Direction.Magnitude > 0 and Direction.Unit or Vector3.zAxis
	local CFrameValue = CFrame.lookAt(Position, Position + Look) * (Rotation or CFrame.identity)
	if Visual:IsA("Model") then Visual:PivotTo(CFrameValue)
	elseif Visual:IsA("BasePart") then Visual.CFrame = CFrameValue end
end

local function prepareVisual(Visual, ForceVisible)
	if not Visual then return end
	if Visual:IsA("Model") and not Visual.PrimaryPart then
		local Primary = Visual:FindFirstChildWhichIsA("BasePart", true)
		if Primary then Visual.PrimaryPart = Primary end
	end
	for _, Descendant in ipairs(Visual:GetDescendants()) do
		if Descendant:IsA("BasePart") then
			Descendant.Anchored = true
			Descendant.CanCollide = false
			Descendant.CanTouch = false
			Descendant.CanQuery = false
			Descendant.Massless = true
			if ForceVisible then
				Descendant.Transparency = 0
				Descendant.LocalTransparencyModifier = 0
			end
		elseif ForceVisible and (Descendant:IsA("Decal") or Descendant:IsA("Texture")) then
			Descendant.Transparency = 0
		end
	end
	if Visual:IsA("BasePart") then
		Visual.Anchored = true
		Visual.CanCollide = false
		Visual.CanTouch = false
		Visual.CanQuery = false
		Visual.Massless = true
		if ForceVisible then
			Visual.Transparency = 0
			Visual.LocalTransparencyModifier = 0
		end
	end
end

function ProjectileController.new(Settings)
	local self = setmetatable({}, ProjectileController)
	self.Settings = copyDefaults(Settings)
	self.Projectiles = {}
	self.Connection = nil
	self.Destroyed = false
	self.ProjectileCreated = Instance.new("BindableEvent")
	self.ProjectileHit = Instance.new("BindableEvent")
	self.ProjectileExpired = Instance.new("BindableEvent")
	return self
end

function ProjectileController:_EnsureConnection()
	if self.Connection or self.Destroyed then return end
	self.Connection = RunService.Heartbeat:Connect(function(DeltaTime) self:_Step(DeltaTime) end)
end

function ProjectileController:_ResolveRaycastParams(Projectile)
	local Params = Projectile.RaycastParams or self.Settings.RaycastParams
	if Params then return Params end
	local NewParams = RaycastParams.new()
	NewParams.FilterType = Enum.RaycastFilterType.Exclude
	NewParams.IgnoreWater = self.Settings.IgnoreWater
	return NewParams
end

function ProjectileController:_ExcludeVisualFromRaycast(Projectile, Params)
	if not Projectile.Visual then return Params end
	local Excluded = {}
	for _, Instance in ipairs(Params.FilterDescendantsInstances) do table.insert(Excluded, Instance) end
	table.insert(Excluded, Projectile.Visual)
	Params.FilterDescendantsInstances = Excluded
	return Params
end

function ProjectileController:_CreateVisual(Projectile, Settings)
	local Source = Settings.Visual
	if Source and Source:IsA("Instance") then
		local Visual = Source:Clone()
		Visual.Name = "ThrownProjectile"
		Visual.Parent = workspace
		prepareVisual(Visual, Settings.ForceVisible == true)
		setVisualCFrame(Visual, Projectile.Position, Projectile.Direction, Projectile.Rotation)
		return Visual
	end

	local ProjectileName = Settings.ProjectileName
	if not ProjectileName then return nil end
	local FolderName = Settings.ProjectileFolderName or self.Settings.ProjectileFolderName
	local Folder = ReplicatedStorage:FindFirstChild(FolderName)
	if not Folder then
		warn(("ProjectileController: ReplicatedStorage.%s does not exist"):format(FolderName))
		return nil
	end
	local Template = Folder:FindFirstChild(ProjectileName)
	if not Template then
		warn(("ProjectileController: projectile '%s' was not found in ReplicatedStorage.%s"):format(ProjectileName, FolderName))
		return nil
	end
	local Visual = Template:Clone()
	Visual.Name = "ThrownProjectile"
	Visual.Parent = workspace
	prepareVisual(Visual, Settings.ForceVisible == true)
	setVisualCFrame(Visual, Projectile.Position, Projectile.Direction, Projectile.Rotation)
	return Visual
end

function ProjectileController:_DestroyVisual(Projectile)
	if Projectile.Visual and Projectile.Visual.Parent then Projectile.Visual:Destroy() end
	Projectile.Visual = nil
end

function ProjectileController:_Step(DeltaTime)
	for Id, Projectile in pairs(self.Projectiles) do
		if Projectile.Destroyed then self.Projectiles[Id] = nil; continue end
		Projectile.Age += DeltaTime
		if Projectile.Age >= Projectile.MaxLifetime then
			self:_Expire(Projectile); self.Projectiles[Id] = nil; continue
		end
		local OldPosition = Projectile.Position
		Projectile.Velocity += Projectile.Gravity * DeltaTime
		local NewPosition = OldPosition + Projectile.Velocity * DeltaTime
		local Travel = NewPosition - OldPosition
		local Params = self:_ExcludeVisualFromRaycast(Projectile, self:_ResolveRaycastParams(Projectile))
		local Result = workspace:Raycast(OldPosition, Travel, Params)
		if Result then
			Projectile.Position = Result.Position
			if Projectile.SpinSpeed and Projectile.SpinSpeed.Magnitude > 0 then Projectile.SpinAngle += Projectile.SpinSpeed * DeltaTime end
			setVisualCFrame(Projectile.Visual, Projectile.Position, Projectile.Direction, CFrame.Angles(Projectile.SpinAngle.X, Projectile.SpinAngle.Y, Projectile.SpinAngle.Z) * Projectile.Rotation)
			self:_Hit(Projectile, Result)
			self.Projectiles[Id] = nil
		else
			Projectile.Position = NewPosition
			if Projectile.Velocity.Magnitude > 0 then Projectile.Direction = Projectile.Velocity.Unit end
			if Projectile.SpinSpeed and Projectile.SpinSpeed.Magnitude > 0 then Projectile.SpinAngle += Projectile.SpinSpeed * DeltaTime end
			setVisualCFrame(Projectile.Visual, Projectile.Position, Projectile.Direction, CFrame.Angles(Projectile.SpinAngle.X, Projectile.SpinAngle.Y, Projectile.SpinAngle.Z) * Projectile.Rotation)
			if Projectile.OnStep then Projectile.OnStep(Projectile, DeltaTime) end
		end
	end
	if next(self.Projectiles) == nil and self.Connection then self.Connection:Disconnect(); self.Connection = nil end
end

function ProjectileController:_Hit(Projectile, Result)
	Projectile.Destroyed = true
	if Projectile.OnHit then
		local Ok, ErrorMessage = xpcall(function() Projectile.OnHit(Projectile, Result) end, debug.traceback)
		if not Ok then warn("[ProjectileController] OnHit ERROR:\n" .. tostring(ErrorMessage)) end
	end
	self:_DestroyVisual(Projectile)
	self.ProjectileHit:Fire(Projectile, Result)
end

function ProjectileController:_Expire(Projectile)
	Projectile.Destroyed = true
	if Projectile.OnExpire then Projectile.OnExpire(Projectile) end
	self:_DestroyVisual(Projectile)
	self.ProjectileExpired:Fire(Projectile)
end

function ProjectileController:Fire(Origin, Direction, Settings)
	if self.Destroyed or typeof(Origin) ~= "Vector3" or typeof(Direction) ~= "Vector3" or Direction.Magnitude <= 0 then return nil end
	Settings = Settings or {}
	local Projectile = {
		Id = {}, Origin = Origin, Position = Origin, Direction = Direction.Unit,
		Velocity = Direction.Unit * (Settings.Speed or self.Settings.Speed), Gravity = Settings.Gravity or self.Settings.Gravity,
		MaxLifetime = Settings.MaxLifetime or self.Settings.MaxLifetime, Age = 0, Destroyed = false,
		RaycastParams = Settings.RaycastParams or self.Settings.RaycastParams,
		OnStep = Settings.OnStep, OnHit = Settings.OnHit, OnExpire = Settings.OnExpire, Data = Settings.Data,
		Visual = nil, Rotation = Settings.Rotation or CFrame.identity, SpinSpeed = Settings.SpinSpeed, SpinAngle = Vector3.zero,
	}
	Projectile.Visual = self:_CreateVisual(Projectile, Settings)
	if Settings.Visual and not Projectile.Visual then
		warn("[ProjectileController] Failed to create projectile visual")
		return nil
	end
	self.Projectiles[Projectile.Id] = Projectile
	self.ProjectileCreated:Fire(Projectile)
	self:_EnsureConnection()
	return Projectile
end

function ProjectileController:DestroyProjectile(Projectile)
	if not Projectile or Projectile.Destroyed then return end
	Projectile.Destroyed = true
	self:_DestroyVisual(Projectile)
	self.Projectiles[Projectile.Id] = nil
end

function ProjectileController:GetActiveCount()
	local Count = 0
	for _ in pairs(self.Projectiles) do Count += 1 end
	return Count
end

function ProjectileController:Destroy()
	if self.Destroyed then return end
	self.Destroyed = true
	if self.Connection then self.Connection:Disconnect(); self.Connection = nil end
	for _, Projectile in pairs(self.Projectiles) do Projectile.Destroyed = true; self:_DestroyVisual(Projectile) end
	self.Projectiles = {}
	self.ProjectileCreated:Destroy(); self.ProjectileHit:Destroy(); self.ProjectileExpired:Destroy()
end

return ProjectileController
