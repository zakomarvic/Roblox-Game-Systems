local CharacterRagdoll = {}
CharacterRagdoll.__index = CharacterRagdoll

local function getAttachments(part0, part1, c0, c1)
	local attachment0 = Instance.new("Attachment")
	attachment0.Name = "RagdollAttachment0"
	attachment0.CFrame = c0
	attachment0.Parent = part0

	local attachment1 = Instance.new("Attachment")
	attachment1.Name = "RagdollAttachment1"
	attachment1.CFrame = c1
	attachment1.Parent = part1

	return attachment0, attachment1
end

function CharacterRagdoll.new(character)
	local self = setmetatable({}, CharacterRagdoll)
	self.Character = character
	self.Ragdolled = false
	self.Motors = {}
	self.Constraints = {}
	self.Attachments = {}
	return self
end

function CharacterRagdoll:_Build()
	self:_DestroyConstraints()

	for _, joint in ipairs(self.Character:GetDescendants()) do
		if joint:IsA("Motor6D") and joint.Part0 and joint.Part1 and joint.Name ~= "RootJoint" then
			local attachment0, attachment1 = getAttachments(joint.Part0, joint.Part1, joint.C0, joint.C1)
			local constraint = Instance.new("BallSocketConstraint")
			constraint.Name = "RagdollConstraint_" .. joint.Name
			constraint.Attachment0 = attachment0
			constraint.Attachment1 = attachment1
			constraint.LimitsEnabled = true
			constraint.UpperAngle = 45
			constraint.Parent = joint.Parent

			table.insert(self.Motors, joint)
			table.insert(self.Attachments, attachment0)
			table.insert(self.Attachments, attachment1)
			table.insert(self.Constraints, constraint)
		end
	end
end

function CharacterRagdoll:_DestroyConstraints()
	for _, constraint in ipairs(self.Constraints) do
		constraint:Destroy()
	end
	for _, attachment in ipairs(self.Attachments) do
		attachment:Destroy()
	end
	self.Constraints = {}
	self.Attachments = {}
	self.Motors = {}
end

function CharacterRagdoll:SetRagdolled(enabled)
	if self.Ragdolled == enabled then
		return
	end

	if enabled then
		self:_Build()
		for _, motor in ipairs(self.Motors) do
			motor.Enabled = false
		end
		self.Ragdolled = true
	else
		for _, motor in ipairs(self.Motors) do
			motor.Enabled = true
		end
		self:_DestroyConstraints()
		self.Ragdolled = false
	end
end

function CharacterRagdoll:IsRagdolled()
	return self.Ragdolled
end

function CharacterRagdoll:Destroy()
	self:SetRagdolled(false)
	self.Character = nil
end

return CharacterRagdoll
