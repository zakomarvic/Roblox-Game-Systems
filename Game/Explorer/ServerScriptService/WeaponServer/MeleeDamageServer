local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")

local WeaponSystem = ReplicatedStorage:WaitForChild("WeaponSystem")
local Remotes = WeaponSystem:FindFirstChild("Remotes") or Instance.new("Folder")
Remotes.Name = "Remotes"
Remotes.Parent = WeaponSystem

local MeleeRemote = Remotes:FindFirstChild("Melee") or Instance.new("RemoteEvent")
MeleeRemote.Name = "Melee"
MeleeRemote.Sandboxed = true
MeleeRemote.Parent = Remotes

local ProjectileController = require(WeaponSystem.Modules:WaitForChild("ProjectileController"))
local ProjectileSystem = ProjectileController.new()

local ActiveAttacks = {}
local LastAttacks = {}
local LastThrows = {}

local function getOwnedEquippedWeapon(Player, Tool)
	if not Tool or not Tool:IsA("Tool") then return nil, nil end
	local Character = Player.Character
	if not Character or Tool.Parent ~= Character then return nil, nil end
	local Setting = Tool:FindFirstChild("Setting")
	if not Setting or not Setting:IsA("ModuleScript") then return nil, nil end
	local Module = require(Setting)
	if type(Module) ~= "table" or Module.WeaponType ~= "Melee" or Module.MeleeEnabled == false then return nil, nil end
	return Tool, Module
end

local function getHumanoid(Character)
	return Character and Character:FindFirstChildOfClass("Humanoid")
end

local function getTorso(Character)
	return Character and (Character:FindFirstChild("HumanoidRootPart") or Character:FindFirstChild("Torso"))
end

local function clearAttack(Player, Tool)
	local PlayerAttacks = ActiveAttacks[Player]
	if PlayerAttacks then
		PlayerAttacks[Tool] = nil
		if next(PlayerAttacks) == nil then ActiveAttacks[Player] = nil end
	end
end

local function isValidTarget(Player, TargetHumanoid, HitPart)
	if typeof(TargetHumanoid) ~= "Instance" or not TargetHumanoid:IsA("Humanoid") then return nil end
	if typeof(HitPart) ~= "Instance" or not HitPart:IsA("BasePart") then return nil end
	if TargetHumanoid.Health <= 0 then return nil end
	local TargetCharacter = TargetHumanoid.Parent
	local Character = Player.Character
	if not TargetCharacter or not TargetCharacter:IsA("Model") or TargetCharacter == Character then return nil end
	if TargetCharacter:FindFirstChildOfClass("Humanoid") ~= TargetHumanoid then return nil end
	if not HitPart:IsDescendantOf(TargetCharacter) then return nil end
	local TargetTorso = getTorso(TargetCharacter)
	if not TargetTorso then return nil end
	return TargetCharacter, TargetTorso
end

local function setToolVisible(Tool, Visible)
	for _, Descendant in ipairs(Tool:GetDescendants()) do
		if Descendant:IsA("BasePart") or Descendant:IsA("Decal") or Descendant:IsA("Texture") then
			if Visible then
				local Original = Descendant:GetAttribute("MeleeThrowOriginalTransparency")
				if Original ~= nil then
					Descendant.Transparency = Original
					Descendant:SetAttribute("MeleeThrowOriginalTransparency", nil)
				end
			else
				if Descendant:GetAttribute("MeleeThrowOriginalTransparency") == nil then
					Descendant:SetAttribute("MeleeThrowOriginalTransparency", Descendant.Transparency)
				end
				Descendant.Transparency = 1
			end
		end
	end
end

local function applyDamage(Player, TargetHumanoid, Damage)
	if Damage <= 0 then return end
	local Creator = TargetHumanoid:FindFirstChild("creator")
	if Creator then Creator:Destroy() end
	Creator = Instance.new("ObjectValue")
	Creator.Name = "creator"
	Creator.Value = Player
	Creator.Parent = TargetHumanoid
	Debris:AddItem(Creator, 5)
	TargetHumanoid:TakeDamage(Damage)
end

local function throwWeapon(Player, Tool, Origin, Direction, Module)
	if Module.ThrowEnabled ~= true then return end
	local Character = Player.Character
	local Humanoid = getHumanoid(Character)
	local Handle = Tool:FindFirstChild("Handle")
	if not Humanoid or Humanoid.Health <= 0 or not Handle or not Handle:IsA("BasePart") then return end
	if typeof(Origin) ~= "Vector3" or typeof(Direction) ~= "Vector3" or Direction.Magnitude <= 0 then return end

	local Now = os.clock()
	local Cooldown = math.max(0, tonumber(Module.ThrowCooldown) or 1)
	local Last = LastThrows[Player] and LastThrows[Player][Tool] or -math.huge
	if Now - Last < Cooldown then return end
	LastThrows[Player] = LastThrows[Player] or {}
	LastThrows[Player][Tool] = Now

	local ServerOrigin = Handle.Position
	local ServerDirection = Direction.Unit
	local Params = RaycastParams.new()
	Params.FilterType = Enum.RaycastFilterType.Exclude
	Params.FilterDescendantsInstances = {Character, Tool}
	Params.IgnoreWater = true

	-- Hide the equipped copy before the throw is replicated. The projectile
	-- controller receives ForceVisible so its independent clone stays visible.
	setToolVisible(Tool, false)
	local Projectile = ProjectileSystem:Fire(ServerOrigin, ServerDirection, {
		Speed = math.clamp(tonumber(Module.ThrowSpeed) or 120, 1, 1000),
		Gravity = Module.ThrowGravity or Vector3.new(0, -workspace.Gravity * 0.35, 0),
		MaxLifetime = math.clamp(tonumber(Module.ThrowLifetime) or 5, 0.1, 30),
		Visual = Handle,
		ForceVisible = true,
		SpinSpeed = Module.ThrowSpin and Vector3.new(0, 0, math.rad(1080)) or nil,
		RaycastParams = Params,
		Data = {Player = Player, Tool = Tool},
		OnHit = function(Thrown, Result)
			local TargetHumanoid
			if Result.Instance then
				local Model = Result.Instance:FindFirstAncestorOfClass("Model")
				TargetHumanoid = Model and Model:FindFirstChildOfClass("Humanoid")
			end
			if TargetHumanoid and TargetHumanoid.Health > 0 and TargetHumanoid.Parent ~= Character then
				local Damage = tonumber(Module.ThrowDamage) or tonumber(Module.BaseDamage) or 0
				applyDamage(Player, TargetHumanoid, Damage)
				warn("[MeleeDamageServer] THROW HIT", Player.Name, TargetHumanoid.Parent:GetFullName(), "damage", Damage)
			end
			setToolVisible(Tool, true)
		end,
		OnExpire = function()
			setToolVisible(Tool, true)
		end,
	})

	if not Projectile then setToolVisible(Tool, true) end
end

MeleeRemote.OnServerEvent:Connect(function(Player, Action, Tool, TargetHumanoid, HitPart)
	if type(Action) ~= "string" then return end
	local OwnedTool, Module = getOwnedEquippedWeapon(Player, Tool)
	if not OwnedTool then return end

	if Action == "Throw" then
		throwWeapon(Player, Tool, TargetHumanoid, HitPart, Module)
		return
	end

	local Character = Player.Character
	local Humanoid = getHumanoid(Character)
	local Handle = Tool:FindFirstChild("Handle")
	if not Humanoid or Humanoid.Health <= 0 or not Handle or not Handle:IsA("BasePart") then return end
	local Now = os.clock()
	local Cooldown = math.max(0, tonumber(Module.AttackCooldown) or 0)
	local Duration = math.clamp(tonumber(Module.AttackDuration) or 0, 0, 2)

	if Action == "Start" then
		local Last = LastAttacks[Player] and LastAttacks[Player][Tool] or -math.huge
		if Now - Last < Cooldown then return end
		LastAttacks[Player] = LastAttacks[Player] or {}
		LastAttacks[Player][Tool] = Now
		ActiveAttacks[Player] = ActiveAttacks[Player] or {}
		ActiveAttacks[Player][Tool] = {EndTime = Now + Duration, HitTargets = {}}
		return
	end

	if Action ~= "Hit" then return end
	local PlayerAttacks = ActiveAttacks[Player]
	local Attack = PlayerAttacks and PlayerAttacks[Tool]
	if not Attack or Now > Attack.EndTime + 0.05 then
		clearAttack(Player, Tool)
		return
	end

	local TargetCharacter, TargetTorso = isValidTarget(Player, TargetHumanoid, HitPart)
	if not TargetCharacter or Attack.HitTargets[TargetHumanoid] then return end
	local Distance = (TargetTorso.Position - Handle.Position).Magnitude
	if Distance > math.max(10, Handle.Size.Magnitude + 6) then return end

	local Params = RaycastParams.new()
	Params.FilterType = Enum.RaycastFilterType.Exclude
	Params.FilterDescendantsInstances = {Character, Tool}
	Params.IgnoreWater = true
	local Offset = HitPart.Position - Handle.Position
	if Offset.Magnitude <= 0 then return end
	local Result = workspace:Raycast(Handle.Position, Offset, Params)
	if Result and not Result.Instance:IsDescendantOf(TargetCharacter) then return end

	Attack.HitTargets[TargetHumanoid] = true
	local Damage = tonumber(Module.BaseDamage) or 0
	applyDamage(Player, TargetHumanoid, Damage)

	local Knockback = tonumber(Module.MeleeKnockback) or 0
	if Knockback > 0 then
		local Direction = TargetTorso.Position - Handle.Position
		if Direction.Magnitude > 0 then TargetTorso.AssemblyLinearVelocity += Direction.Unit * Knockback end
	end
	warn("[MeleeDamageServer] HIT", Player.Name, TargetCharacter:GetFullName(), "damage", Damage)
end)

Players.PlayerRemoving:Connect(function(Player)
	ActiveAttacks[Player] = nil
	LastAttacks[Player] = nil
	LastThrows[Player] = nil
end)
