local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local WeaponSystem = ReplicatedStorage:WaitForChild("WeaponSystem")
local Remotes = WeaponSystem:WaitForChild("Remotes")
local InflictTarget = Remotes:WaitForChild("InflictTarget")
local Explosion = Remotes:FindFirstChild("Explosion")
if not Explosion then
	Explosion = Instance.new("RemoteEvent")
	Explosion.Name = "Explosion"
	Explosion.Parent = Remotes
end

local WeaponState = require(WeaponSystem.Modules:WaitForChild("WeaponState"))
local BulletEffects = require(WeaponSystem.Modules:WaitForChild("BulletEffects"))

local function getEquippedWeapon(Player)
	local Character = Player.Character
	if not Character then return nil, nil end

	local Tool = Character:FindFirstChildOfClass("Tool")
	if not Tool then return nil, nil end

	local Setting = Tool:FindFirstChild("Setting")
	if not Setting or not Setting:IsA("ModuleScript") then return nil, nil end

	local Module = require(Setting)
	if type(Module) ~= "table" then return nil, nil end
	return Tool, Module
end

local function getTorso(Character)
	return Character and (Character:FindFirstChild("Torso") or Character:FindFirstChild("HumanoidRootPart"))
end

InflictTarget.OnServerEvent:Connect(function(Player, TargetHumanoid, TargetTorso, HitPart, Direction)
	if not Player then return end
	if not TargetHumanoid or not TargetHumanoid:IsA("Humanoid") then return end
	if not TargetTorso or not TargetTorso:IsA("BasePart") then return end
	if not HitPart or not HitPart:IsA("BasePart") then return end
	if TargetHumanoid.Health <= 0 then return end

	local TargetCharacter = TargetHumanoid.Parent
	if not TargetCharacter or not TargetCharacter:IsA("Model") then return end
	if HitPart:FindFirstAncestorOfClass("Model") ~= TargetCharacter then return end
	if TargetCharacter:FindFirstChildOfClass("Humanoid") ~= TargetHumanoid then return end
	if not HitPart:IsDescendantOf(TargetCharacter) then return end
	if not TargetTorso:IsDescendantOf(TargetCharacter) then return end
	if TargetCharacter == Player.Character then return end
	if typeof(Direction) ~= "Vector3" or Direction.Magnitude <= 0 then return end

	Direction = Direction.Unit

	local Character = Player.Character
	local ShooterHumanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local ShooterTorso = getTorso(Character)
	if not ShooterHumanoid or not ShooterTorso or ShooterHumanoid.Health <= 0 then return end

	local Tool, Module = getEquippedWeapon(Player)
	if not Tool then return end

	local State = WeaponState.Get(Player, Tool)
	if not State or State.Reloading then return end
	if os.clock() - State.LastShot > 0.25 then return end

	local Start = (ShooterTorso.CFrame * CFrame.new(0, 1.5, 0)).Position

	local RaycastParams = RaycastParams.new()
	RaycastParams.FilterType = Enum.RaycastFilterType.Exclude
	RaycastParams.FilterDescendantsInstances = {Character, Tool}
	RaycastParams.IgnoreWater = true

	local ToTarget = HitPart.Position - Start
	if ToTarget.Magnitude <= 0 or ToTarget.Magnitude > 5000 then return end

	local Result = workspace:Raycast(Start, ToTarget, RaycastParams)
	if Result then
		local ResultCharacter = Result.Instance:FindFirstAncestorOfClass("Model")
		if ResultCharacter ~= TargetCharacter then return end
	end

	local AlongShot = ToTarget:Dot(Direction)
	if AlongShot <= 0 or AlongShot > 5000 then return end

	local ClosestPoint = Start + Direction * AlongShot
	if (HitPart.Position - ClosestPoint).Magnitude > 8 then return end

	local Damage = tonumber(Module.BaseDamage)
	if not Damage or Damage <= 0 then return end

	if HitPart.Name == "Head" and Module.HeadshotEnabled then
		Damage *= tonumber(Module.HeadshotDamageMultiplier) or 1
	end

	local Knockback = tonumber(Module.Knockback) or 0
	local Lifesteal = tonumber(Module.Lifesteal) or 0
	local FlamingBullet = Module.FlamingBullet == true

	while TargetHumanoid:FindFirstChild("creator") do
		TargetHumanoid.creator:Destroy()
	end

	local Creator = Instance.new("ObjectValue")
	Creator.Name = "creator"
	Creator.Value = Player
	Creator.Parent = TargetHumanoid
	game.Debris:AddItem(Creator, 5)

	TargetHumanoid:TakeDamage(Damage)

	if Knockback > 0 then
		TargetTorso.AssemblyLinearVelocity += Direction * Knockback
	end

	if Lifesteal > 0 and ShooterHumanoid.Health > 0 then
		ShooterHumanoid.Health += Damage * Lifesteal
	end

	if FlamingBullet then
		BulletEffects.Apply("Incendiary", {
			Player = Player,
			Tool = Tool,
			Module = Module,
			TargetCharacter = TargetCharacter,
			TargetHumanoid = TargetHumanoid,
			TargetTorso = TargetTorso,
			HitPart = HitPart,
			Direction = Direction,
			Duration = Module.FlamingBulletDuration,
		})
	end
end)

Explosion.OnServerEvent:Connect(function(Player, Position, Direction)
	if typeof(Position) ~= "Vector3" then return end
	if typeof(Direction) ~= "Vector3" or Direction.Magnitude <= 0 then return end

	local Character = Player.Character
	local ShooterHumanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local ShooterTorso = getTorso(Character)
	if not ShooterHumanoid or not ShooterTorso or ShooterHumanoid.Health <= 0 then return end

	local Tool, Module = getEquippedWeapon(Player)
	if not Tool or Module.ProjectileType ~= "Projectile" or Module.ExplosiveEnabled ~= true then return end

	local State = WeaponState.Get(Player, Tool)
	if not State or State.Reloading then return end
	if os.clock() - State.LastShot > 0.5 then return end

	local Radius = tonumber(Module.ExplosionRadius) or 0
	local Damage = tonumber(Module.ExplosionDamage) or 0
	local Knockback = tonumber(Module.ExplosionKnockback) or 0
	if Radius <= 0 or Damage <= 0 then return end

	local MaxDistance = ((tonumber(Module.ProjectileSpeed) or 500) * (tonumber(Module.ProjectileLifetime) or 10)) + Radius
	if (Position - ShooterTorso.Position).Magnitude > MaxDistance then return end

	Direction = Direction.Unit

	for _, TargetCharacter in ipairs(workspace:GetChildren()) do
		if TargetCharacter:IsA("Model") then
			local TargetHumanoid = TargetCharacter:FindFirstChildOfClass("Humanoid")
			local TargetTorso = getTorso(TargetCharacter)

			if TargetHumanoid and TargetTorso and TargetHumanoid.Health > 0 then
				local Offset = TargetTorso.Position - Position
				local Distance = Offset.Magnitude

				if Distance <= Radius then
					local ExplosionDirection = Distance > 0 and Offset.Unit or Direction
					local Falloff = 1 - math.clamp(Distance / Radius, 0, 1)
					local AppliedDamage = Damage * Falloff

					if AppliedDamage > 0 then
						while TargetHumanoid:FindFirstChild("creator") do
							TargetHumanoid.creator:Destroy()
						end

						local Creator = Instance.new("ObjectValue")
						Creator.Name = "creator"
						Creator.Value = Player
						Creator.Parent = TargetHumanoid
						game.Debris:AddItem(Creator, 5)

						TargetHumanoid:TakeDamage(AppliedDamage)
					end

					if Knockback > 0 then
						TargetTorso.AssemblyLinearVelocity += ExplosionDirection * (Knockback * Falloff)
					end
				end
			end
		end
	end
end)

Players.PlayerRemoving:Connect(function(Player)
	WeaponState.ClearPlayer(Player)
end)
