local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WeaponAnimations = require(
	ReplicatedStorage.WeaponSystem.Modules.WeaponAnimations
)

local WeaponPose = require(
	ReplicatedStorage.WeaponSystem.Modules.WeaponPose
)

local WeaponGrip = require(
	ReplicatedStorage.WeaponSystem.Modules.WeaponGrip
)

local WeaponService = {}
local ActiveWeapons = {}

function WeaponService.Initialize(Tool)
	if not Tool or not Tool:IsA("Tool") then
		return nil
	end

	if ActiveWeapons[Tool] then
		return ActiveWeapons[Tool]
	end

	local Module = require(Tool:WaitForChild("Setting"))
	WeaponAnimations.Create(Tool, Module)

	local State = {
		Tool = Tool,
		Module = Module,
		CurrentPose = nil,
		GripData = nil,
	}

	State.EquippedConnection = Tool.Equipped:Connect(function()
		local Character = Tool.Parent

		State.CurrentPose = WeaponPose.Equip(Character, Module)

		if Module.DualEnabled and workspace.FilteringEnabled then
			State.GripData = WeaponGrip.Equip(Tool, Module)
		end
	end)

	State.UnequippedConnection = Tool.Unequipped:Connect(function()
		WeaponPose.Unequip(State.CurrentPose)
		State.CurrentPose = nil

		if State.GripData then
			WeaponGrip.Unequip(State.GripData)
			State.GripData = nil
		end
	end)

	ActiveWeapons[Tool] = State
	return State
end

function WeaponService.Destroy(Tool)
	local State = ActiveWeapons[Tool]
	if not State then
		return
	end

	if State.CurrentPose then
		WeaponPose.Unequip(State.CurrentPose)
		State.CurrentPose = nil
	end

	if State.GripData then
		WeaponGrip.Unequip(State.GripData)
		State.GripData = nil
	end

	if State.EquippedConnection then
		State.EquippedConnection:Disconnect()
	end

	if State.UnequippedConnection then
		State.UnequippedConnection:Disconnect()
	end

	ActiveWeapons[Tool] = nil
end

return WeaponService
