local Player = game.Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WeaponSystem = ReplicatedStorage:WaitForChild("WeaponSystem")
local Remotes = WeaponSystem:WaitForChild("Remotes")

local BulletVisualizer = require(
	WeaponSystem.Modules:WaitForChild("BulletVisualizer")
)

local WeaponEffects = Remotes:WaitForChild("WeaponEffects")

local function playFireSound(Tool, ShootingHandle)
	if not Tool or not Tool:IsA("Tool") then
		return
	end

	if not ShootingHandle or not ShootingHandle:IsA("BasePart") then
		return
	end

	local FireSound = ShootingHandle:FindFirstChild("FireSound") or ShootingHandle:FindFirstChild("shoot")
	if FireSound and FireSound:IsA("Sound") then
		FireSound:Play()
	end
end

local function playFireEffects(Tool, ShootingHandle)
	if not Tool or not Tool:IsA("Tool") then
		return
	end

	local Handle = ShootingHandle or Tool:FindFirstChild("Handle")
	if not Handle or not Handle:IsA("BasePart") then
		return
	end

	local Bolt = Tool:FindFirstChild("Bolt")
	local BoltBack = Tool:FindFirstChild("BoltBack")
	local Shell = Tool:FindFirstChild("shell")
	local Flash = Tool:FindFirstChild("Flash")

	if Bolt then Bolt.Transparency = 1 end
	if BoltBack then BoltBack.Transparency = 0 end

	if Shell then
		local Casing = Shell:Clone()
		Casing.Parent = workspace
		Casing.Transparency = 0
		Casing:BreakJoints()
		Casing.Position = Shell.Position

		task.delay(2, function()
			if Casing and Casing.Parent then
				Casing:Destroy()
			end
		end)
	end

	if Flash then
		local Light = Flash:FindFirstChild("Light")
		local Lite = Flash:FindFirstChild("lite")
		if Light then Light.Enabled = true end
		if Lite then Lite.Enabled = true end

		task.delay(0.08, function()
			if Light then Light.Enabled = false end
			if Lite then Lite.Enabled = false end
		end)
	else
		task.delay(0.08, function()
			if Bolt then Bolt.Transparency = 0 end
			if BoltBack then BoltBack.Transparency = 1 end
		end)
	end

	task.delay(0.08, function()
		if Bolt then Bolt.Transparency = 0 end
		if BoltBack then BoltBack.Transparency = 1 end
	end)
end

WeaponEffects.OnClientEvent:Connect(function(
	Effect,
	Shooter,
	Tool,
	ShootingHandle,
	MuzzleOffset,
	EndPos,
	MuzzleEffect,
	HitEffect,
	HitSound,
	ExplosiveData,
	BulletData,
	VisualizeExplosion,
	VisualizeEnabled
)
	if Effect == "Fire" then
		if Shooter and Shooter ~= Player then
			local Character = Shooter.Character
			Tool = Tool or (Character and Character:FindFirstChildOfClass("Tool"))

			if Tool then
				local Handle = ShootingHandle or Tool:FindFirstChild("Handle")
				playFireSound(Tool, Handle)
				playFireEffects(Tool, Handle)
			end
		end

		return
	end

	if Effect ~= "Bullet" then
		return
	end

	-- Don't visualize our own bullet here.
	if Shooter == Player then
		return
	end

	BulletVisualizer.Visualize(
		ShootingHandle,
		MuzzleOffset,
		EndPos,
		MuzzleEffect,
		HitEffect,
		HitSound,
		ExplosiveData,
		BulletData,
		VisualizeExplosion,
		VisualizeEnabled
	)
end)
